# Copy this file to backend/.env for local development.
# Never commit your real .env or API keys.

APP_NAME="Smart Reporting API"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

llm_api_key="ak_d8a28043530a4f14bfbf9073ef45ee6f271c28b39e6148f7"
llm_base_url=https://api.edrac.ir
llm_model=edrac-2

EMBEDDING_BASE_URL=http://212.80.22.161:8003/v1/embeddings
# Leave blank until the provider confirms whether a model name is required.
EMBEDDING_MODEL="local-embedding-model"
# Leave blank if the endpoint truly does not require authentication.
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30

DATABASE_URL=sqlite:///./data/smart_reporting.db
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
CHROMA_DIR=./data/chroma

MAX_UPLOAD_MB=25
ALLOWED_PDF_EXTENSIONS=.pdf
